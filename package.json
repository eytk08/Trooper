{
  "name": "trooper",
  "version": "1.0.0",
  "description": "Trooper: an automated hospital appointment assistant (chatbot, MySQL, scheduled reminders)",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "start:prod": "npm run db:ensure && node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/init-db.js --seed",
    "db:ensure": "node scripts/init-db.js --seed --if-empty",
    "test": "node --test",
    "client:install": "npm --prefix client ci",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm run client:install && npm run client:build"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.5"
  },
  "author": "Phoebe Kate",
  "keywords": [
    "chatbot",
    "appointment-scheduling",
    "automation",
    "mysql",
    "express",
    "react",
    "vite",
    "tailwindcss"
  ]
  
}
