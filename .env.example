# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=trooper
# Set to true if your hosted database requires TLS
DB_SSL=false

# Hospital time zone. Slots and reminders use this zone.
TZ=Asia/Manila

# Staff dashboard sign-in (http://localhost:3000/staff/). Leave the password empty to turn sign-in off.
STAFF_USERNAME=admin
STAFF_PASSWORD=change_this_password
# Hours a staff session lasts before signing in again
STAFF_SESSION_HOURS=8
# Optional. Signs the session tokens. If empty, a random one is made on each start,
# so everyone is signed out whenever the server restarts.
# STAFF_SESSION_SECRET=a_long_random_string

# Legacy dashboard at /admin.html (read-only, uses a shared token). Leave empty to turn it off.
ADMIN_TOKEN=change_this_to_a_long_random_string

# Booking rules
BOOKING_LEAD_DAYS=1
BOOKING_WINDOW_DAYS=14
REMINDER_HOURS=24
# Bookings allowed per visitor per hour
BOOKING_RATE_LIMIT=20

# How often the automation job checks the queue (seconds)
NOTIFIER_INTERVAL_SECONDS=30

# Set to production when hosting behind HTTPS
# NODE_ENV=production
